# Until juicebox.js 4.6.0 is on npm, npm cannot install the peer dependency of
# packages/remote (juicebox.js >=4.6.0 <5) and `npm install` fails with ETARGET.
# The tests use a fake juicebox.js, so the repo does not need it. Remove this file
# once 4.6.0 is published. It is not part of the published package.
legacy-peer-deps=true
