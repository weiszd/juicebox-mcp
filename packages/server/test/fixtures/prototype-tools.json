[
  {
    "name": "load_map",
    "inputSchema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL to the .hic file"
        },
        "name": {
          "type": "string",
          "description": "Optional name for the map"
        },
        "normalization": {
          "type": "string",
          "description": "Normalization method (e.g., \"VC\", \"VC_SQRT\", \"KR\", \"NONE\")"
        },
        "locus": {
          "type": "string",
          "description": "Optional genomic locus (e.g., \"1:1000000-2000000 1:1000000-2000000\")"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "load_control_map",
    "inputSchema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL to the control .hic file"
        },
        "name": {
          "type": "string",
          "description": "Optional name for the control map"
        },
        "normalization": {
          "type": "string",
          "description": "Normalization method (e.g., \"VC\", \"VC_SQRT\", \"KR\", \"NONE\")"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "load_session",
    "inputSchema": {
      "type": "object",
      "properties": {
        "sessionData": {
          "type": "string",
          "description": "JSON string of session data (use when pasting JSON directly into chat)"
        },
        "sessionUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL to fetch session JSON from remote source (e.g., Dropbox, AWS S3, GitHub raw file URL)"
        },
        "fileContent": {
          "type": "string",
          "description": "Content of attached session file (use when user attaches a .json file to the chat)"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "zoom_in",
    "inputSchema": {
      "type": "object",
      "properties": {
        "centerX": {
          "type": "number",
          "description": "Optional X coordinate for zoom center (pixels)"
        },
        "centerY": {
          "type": "number",
          "description": "Optional Y coordinate for zoom center (pixels)"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "zoom_out",
    "inputSchema": {
      "type": "object",
      "properties": {
        "centerX": {
          "type": "number",
          "description": "Optional X coordinate for zoom center (pixels)"
        },
        "centerY": {
          "type": "number",
          "description": "Optional Y coordinate for zoom center (pixels)"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "set_map_foreground_color",
    "inputSchema": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Hex color code (e.g., \"#ff0000\")"
        },
        "threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Optional threshold value for the color scale"
        }
      },
      "required": [
        "color"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "set_map_background_color",
    "inputSchema": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Hex color code (e.g., \"#ff0000\")"
        }
      },
      "required": [
        "color"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "set_color_scale",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "increase",
            "decrease",
            "set"
          ],
          "description": "Action: \"increase\" doubles the threshold, \"decrease\" halves it, \"set\" uses the provided value"
        },
        "value": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Exact threshold value (required when action is \"set\")"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "load_track",
    "inputSchema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "URL to the track file (e.g., bigWig, bigBed, bed, bedpe), or the keyword \"genes\" for the built-in gene track"
        },
        "name": {
          "type": "string",
          "description": "Optional display name for the track"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Optional track color as hex code (e.g., \"#ff0000\")"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "select_normalization",
    "inputSchema": {
      "type": "object",
      "properties": {
        "normalization": {
          "type": "string",
          "description": "Normalization method. Common values: NONE (raw counts), VC (Coverage), VC_SQRT (Coverage-Sqrt), KR (Balanced / Knight-Ruiz), SCALE, INTER_SCALE, GW_SCALE. The available normalizations depend on the loaded map."
        }
      },
      "required": [
        "normalization"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "list_tracks",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "remove_track",
    "inputSchema": {
      "type": "object",
      "properties": {
        "track": {
          "type": "string",
          "description": "Track name or 1-based index number"
        }
      },
      "required": [
        "track"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "set_track_color",
    "inputSchema": {
      "type": "object",
      "properties": {
        "track": {
          "type": "string",
          "description": "Track name or 1-based index number"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Hex color (e.g., \"#ff0000\"). Omit to reset to default."
        }
      },
      "required": [
        "track"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "set_track_name",
    "inputSchema": {
      "type": "object",
      "properties": {
        "track": {
          "type": "string",
          "description": "Current track name or 1-based index number"
        },
        "name": {
          "type": "string",
          "description": "New display name for the track"
        }
      },
      "required": [
        "track",
        "name"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "set_track_data_range",
    "inputSchema": {
      "type": "object",
      "properties": {
        "track": {
          "type": "string",
          "description": "Track name or 1-based index number"
        },
        "min": {
          "type": "number",
          "description": "Minimum value"
        },
        "max": {
          "type": "number",
          "description": "Maximum value"
        }
      },
      "required": [
        "track",
        "min",
        "max"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "set_track_autoscale",
    "inputSchema": {
      "type": "object",
      "properties": {
        "track": {
          "type": "string",
          "description": "Track name or 1-based index number"
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable (true) or disable (false) autoscale"
        }
      },
      "required": [
        "track"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "set_track_log_scale",
    "inputSchema": {
      "type": "object",
      "properties": {
        "track": {
          "type": "string",
          "description": "Track name or 1-based index number"
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable (true) or disable (false) log scale"
        }
      },
      "required": [
        "track"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "create_shareable_url",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "get_server_status",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "get_juicebox_url",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "juicebox_help",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "list_data_sources",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "goto_locus",
    "inputSchema": {
      "type": "object",
      "properties": {
        "locus": {
          "anyOf": [
            {
              "type": "string",
              "description": "Locus specification as string (natural language, standard format, or gene name). Examples: \"chr1:1000-2000\", \"BRCA1\", \"chromosome 1 from 1000 to 2000\""
            },
            {
              "type": "object",
              "properties": {
                "chr": {
                  "type": "string",
                  "description": "Chromosome name (e.g., \"chr1\")"
                },
                "start": {
                  "type": "number",
                  "description": "Start position in base pairs (1-based)"
                },
                "end": {
                  "type": "number",
                  "description": "End position in base pairs (1-based)"
                }
              },
              "required": [
                "chr"
              ],
              "additionalProperties": false,
              "description": "Locus specification as structured object"
            }
          ],
          "description": "Locus to navigate to."
        }
      },
      "required": [
        "locus"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "search_maps",
    "inputSchema": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "description": "Data source ID ('4dn', 'encode') or 'all' to search all sources. Default: 'all'"
        },
        "query": {
          "type": "string",
          "description": "Natural language search query (e.g., \"human hg38\", \"mouse cells\", \"K562\")"
        },
        "limit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Maximum number of results to return (default: 50)"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "get_data_source_statistics",
    "inputSchema": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "description": "Data source ID ('4dn' or 'encode')"
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "get_map_details",
    "inputSchema": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "description": "Data source ID ('4dn' or 'encode')"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "Index from search results (0-based). Required if url is not provided."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Direct URL to the map. Required if index is not provided."
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "save_session",
    "inputSchema": {
      "type": "object",
      "properties": {
        "filePath": {
          "type": "string",
          "description": "Optional: Ignored on Cloudflare Workers deployment. On local server, full path to save the session file."
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  }
]
